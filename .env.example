# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TWILIO SMS INTEGRATION (Legacy)
# Configure these variables in the AI Studio Settings menu to receive real SMS OTPs.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# GMAIL & EMAIL OTP VERIFICATION INTEGRATION
# Set GMAIL_USER and GMAIL_APP_PASSWORD to send verification OTPs directly to user Gmail inboxes.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Or configure generic SMTP relay (SendGrid, Mailgun, Brevo, Resend, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
